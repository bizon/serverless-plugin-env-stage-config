{
  "name": "serverless-plugin-env-stage-config",
  "version": "2.0.0",
  "description": "osls (Serverless Framework v3) plugin to define environment variable files for stages",
  "author": "Bertrand Marron <bertrand.marron@gmail.com>",
  "repository": "https://github.com/bizon/serverless-plugin-env-stage-config",
  "type": "module",
  "sideEffects": false,
  "source": "./src/index.ts",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "keywords": [
    "osls",
    "serverless",
    "serverless-plugin"
  ],
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "check:ts": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@bizon/semantic-release-config": "^3.1.0",
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node24": "^24.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "eslint-config-xo-bizon": "^4.5.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "xo": "^4.0.0"
  },
  "release": {
    "extends": "@bizon/semantic-release-config"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
